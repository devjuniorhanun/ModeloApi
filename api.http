### Cadastro de Safra
POST http://localhost:81/api/registrations/harvest/crops
Content-Type: application/json; charset=utf-8
Accept: application/json
Authorization: Bearer 2|86yKc7IZIP9pxAGFVRCelvVcVhILFud44FK37CKdf5fa5b28

{
    "agricultural_year_id": "019c5c7c-93bd-732f-8fec-06edfc27e9f3",
    "name": "Safra 2023/2024",
    "culture_ids": ["019c5cfa-56d4-71a0-985e-b06c682e4a13",], // Assuming the culture with ID 1 exists
    "opening_date": "2023-10-01",
    "closing_date": "2024-09-30",
    "status": "A"

}

